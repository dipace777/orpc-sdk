{
  "name": "@agent-runtime/sdk",
  "type": "module",
  "version": "0.0.0",
  "description": "Typed SDK for the Agent Runtime API.",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./contract": {
      "types": "./dist/contract.d.mts",
      "import": "./dist/contract.mjs",
      "default": "./dist/contract.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown --dts src/index.ts src/contract.ts",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm publish",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "latest",
    "@orpc/contract": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "tsdown": "latest",
    "typescript": "latest"
  }
}
