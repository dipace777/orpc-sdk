{
  "name": "@agent-runtime/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit false --outDir dist",
    "db:migrate": "better-auth migrate --config src/auth.ts --yes",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-runtime/contracts": "workspace:*",
    "@better-auth/api-key": "latest",
    "@hono/node-server": "latest",
    "@orpc/server": "latest",
    "better-auth": "latest",
    "better-call": "1.3.5",
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "hono": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@better-auth/cli": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
